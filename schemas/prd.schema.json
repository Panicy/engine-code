{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engin-code.local/schemas/prd.schema.json",
  "title": "PRD",
  "description": "产品需求文档契约。描述要做什么、为什么做、什么不做，以及用户故事和验收标准。PRD 必须人工确认后才能生成可执行任务计划。",
  "type": "object",
  "required": ["schemaVersion", "prdId", "status", "feature", "goals", "userStories", "constraints", "humanApproval"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0", "description": "契约版本。当前固定为 0.1.0。" },
    "prdId": { "type": "string", "pattern": "^PRD-[A-Z0-9][A-Z0-9-]*$", "description": "PRD 唯一 ID。" },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"], "description": "PRD 状态。只有 approved 可以进入任务拆分确认流程。" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "feature": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "branchName": { "type": "string" }
      }
    },
    "impactedBaseIds": {
      "type": "array",
      "description": "本需求涉及的项目内子项目 ID，例如 backend、middle、client。",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "default": []
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "description": "业务目标。用于约束任务拆分方向。",
      "items": { "$ref": "#/$defs/textItem" }
    },
    "nonGoals": {
      "type": "array",
      "items": { "$ref": "#/$defs/textItem" },
      "description": "非目标。明确不做的内容，防止 agent 过度发挥。",
      "default": []
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "default": []
    },
    "userStories": {
      "type": "array",
      "minItems": 1,
      "description": "用户故事列表。任务拆分应围绕用户故事展开。",
      "items": {
        "type": "object",
        "required": ["id", "title", "story", "acceptanceCriteria", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^US-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "story": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/criterion" }
          },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^US-[0-9]{3}$" },
            "default": []
          }
        }
      }
    },
    "businessRules": {
      "type": "array",
      "description": "业务规则。用于指导后端校验、数据库约束、前端提示和测试用例。",
      "items": { "$ref": "#/$defs/businessRule" },
      "default": []
    },
    "dataEntities": {
      "type": "array",
      "description": "需求涉及的数据对象。用于辅助数据库、接口、表单和列表任务拆分。",
      "items": { "$ref": "#/$defs/dataEntity" },
      "default": []
    },
    "permissions": {
      "type": "array",
      "description": "权限要求。用于生成后端权限码、菜单权限 SQL 和前端按钮权限。",
      "items": { "$ref": "#/$defs/permission" },
      "default": []
    },
    "openQuestions": {
      "type": "array",
      "description": "待人工确认问题。存在 open 问题时不建议批准 PRD。",
      "items": { "$ref": "#/$defs/openQuestion" },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "description": "当前默认假设。用于减少任务拆分和执行时的自由发挥。",
      "items": { "$ref": "#/$defs/textItem" },
      "default": []
    },
    "constraints": {
      "type": "object",
      "required": ["techStack", "architecture", "security", "quality"],
      "additionalProperties": false,
      "properties": {
        "techStack": { "type": "array", "items": { "type": "string" } },
        "architecture": { "type": "array", "items": { "type": "string" } },
        "security": { "type": "array", "items": { "type": "string" } },
        "ux": { "type": "array", "items": { "type": "string" }, "default": [] },
        "performance": { "type": "array", "items": { "type": "string" }, "default": [] },
        "quality": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[0-9]{3}$" },
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      },
      "default": []
    },
    "humanApproval": { "$ref": "#/$defs/humanApproval" }
  },
  "$defs": {
    "textItem": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "text", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "businessRule": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^BR-[0-9]{3}$" },
        "text": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "default": "" }
      }
    },
    "dataEntity": {
      "type": "object",
      "required": ["id", "name", "description", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^DE-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "required", "description"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          },
          "default": []
        }
      }
    },
    "permission": {
      "type": "object",
      "required": ["id", "code", "name", "targetBaseId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^PERM-[0-9]{3}$" },
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "targetBaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "default": "" }
      }
    },
    "openQuestion": {
      "type": "object",
      "required": ["id", "question", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3}$" },
        "question": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "answered"] },
        "answer": { "type": "string", "default": "" }
      }
    },
    "humanApproval": {
      "type": "object",
      "required": ["approved", "approvedBy", "approvedAt"],
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "boolean" },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string", "default": "" }
      }
    }
  }
}
