{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engin-code.local/schemas/project.schema.json",
  "title": "Project",
  "description": "业务项目契约。项目只实例化实际子项目，并通过 templateId 引用模板；具体技术栈知识由模板承载。",
  "type": "object",
  "required": ["schemaVersion", "projectId", "name", "status", "bases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0",
      "description": "契约版本。当前固定为 0.1.0。"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "业务项目唯一标识。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "项目显示名称。"
    },
    "description": {
      "type": "string",
      "description": "项目说明。",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"],
      "description": "项目状态。"
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "description": "项目内实际子项目列表。task-plan 使用 targetBaseId 引用这里的 baseId。",
      "items": {
        "type": "object",
        "required": ["baseId", "templateId", "repo", "workspace"],
        "additionalProperties": false,
        "properties": {
          "baseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "项目内子项目 ID，例如 backend、middle、client。"
          },
          "templateId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "引用的模板 ID，例如 backend-starter。"
          },
          "repo": {
            "type": "string",
            "format": "uri",
            "description": "业务项目实际仓库地址。"
          },
          "workspace": {
            "type": "string",
            "minLength": 1,
            "description": "业务项目实际本地目录。"
          },
          "branch": {
            "type": "string",
            "description": "当前项目基座默认工作分支。",
            "default": ""
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "description": "项目级覆盖。用于覆盖模板默认命令、路径和检查。",
            "properties": {
              "allowedPaths": {
                "type": "array",
                "description": "覆盖或补充允许修改路径。",
                "items": { "type": "string" },
                "default": []
              },
              "devCommands": {
                "type": "array",
                "description": "覆盖或补充开发命令。",
                "items": { "type": "string" },
                "default": []
              },
              "checks": {
                "type": "array",
                "description": "项目级检查覆盖。",
                "items": { "$ref": "#/$defs/check" },
                "default": []
              }
            },
            "default": {}
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "name", "type", "command", "required"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "检查 ID。" },
        "name": { "type": "string", "description": "检查名称。" },
        "type": { "type": "string", "enum": ["build", "lint", "typecheck", "unit", "api", "e2e", "health", "command"], "description": "检查类型。" },
        "command": { "type": "string", "description": "检查命令。" },
        "required": { "type": "boolean", "description": "是否必须通过。" }
      }
    }
  }
}
