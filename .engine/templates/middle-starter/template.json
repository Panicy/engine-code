{
  "schemaVersion": "0.1.0",
  "templateId": "middle-starter",
  "name": "Vben 中台基座模板",
  "type": "middle",
  "sourceRepo": "https://gitee.com/Panicy/middle-starter",
  "defaultBranch": "master",
  "workspaceDefaults": {
    "installCommands": ["pnpm install"],
    "devCommands": ["pnpm dev:antd"],
    "healthChecks": [
      {
        "id": "middle-health",
        "type": "http",
        "target": "http://127.0.0.1:5666/"
      },
      {
        "id": "middle-health-script",
        "type": "command",
        "target": "bash script/bin/middle-health-check.sh"
      }
    ]
  },
  "runtimeProfile": {
    "preflightCommands": [
      {
        "id": "middle-preflight",
        "command": "bash script/bin/middle-preflight-check.sh",
        "required": true,
        "description": "检查 Node、pnpm 和 .env.development 必填项。"
      }
    ],
    "startCommands": [
      {
        "id": "middle-dev",
        "command": "pnpm dev:antd",
        "required": true,
        "description": "启动 Vben 中台 dev server。"
      }
    ],
    "healthChecks": [
      {
        "id": "middle-health-script",
        "type": "command",
        "target": "bash script/bin/middle-health-check.sh",
        "required": true,
        "description": "检查中台首页和后端代理目标。"
      },
      {
        "id": "middle-home",
        "type": "http",
        "target": "http://127.0.0.1:5666/",
        "expectedStatuses": [200, 301, 302, 304],
        "required": true,
        "description": "中台首页应可访问。"
      }
    ],
    "browserChecks": [
      {
        "id": "middle-console",
        "url": "http://127.0.0.1:5666/",
        "required": true,
        "failOnConsoleError": true,
        "waitMs": 5000,
        "description": "打开中台首页并捕获 console error 和 pageerror。"
      }
    ]
  },
  "taskPreflightCommands": [
    {
      "id": "middle-dependencies-installed",
      "command": "test -d node_modules && test -x node_modules/.bin/vue-tsc",
      "required": true,
      "description": "确认中台依赖已安装，避免 Codex 在 task 内执行 typecheck 时因 vue-tsc/node_modules 缺失长时间超时。失败时先在 bases/middle 执行 pnpm install。"
    }
  ],
  "pathPolicy": {
    "defaultAllowedPaths": [
      "apps/web-antd/src/api/**",
      "apps/web-antd/src/views/**",
      "apps/web-antd/src/router/**",
      "apps/web-antd/src/locales/**",
      "apps/web-antd/src/components/**",
      "packages/**"
    ]
  },
  "defaultChecks": []
}
